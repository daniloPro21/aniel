{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(webp|jpg|png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/(tw\\.css|ticket\\.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
