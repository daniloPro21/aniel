# Vercel > Project > Settings > Environment Variables
# Si vous avez connecté Supabase via l'intégration Vercel, ces variables existent déjà
# (NEXT_PUBLIC_STORAGE_ANIELSUPABASE_URL et STORAGE_SUPABASE_SERVICE_ROLE_KEY) : le code les reconnaît.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # clé "service_role" (SECRÈTE)
# À créer dans tous les cas : clé pour consulter la liste des invités (/api/guests?key=...)
ADMIN_KEY=choisissez-une-longue-phrase-secrete
